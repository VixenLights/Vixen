<catel:Window x:Class="TimedSequenceEditor.Forms.WPF.MarksDocker.Views.MarkCollectionImportSelectionWindow"
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:catel="http://schemas.catelproject.com"
			  xmlns:viewModels="clr-namespace:TimedSequenceEditor.Forms.WPF.MarksDocker.ViewModels"
			  WindowStartupLocation="CenterScreen"
			  CanCloseUsingEscape="True"
			  WindowStyle="ToolWindow"
			  Title="Select Imported Mark Collections"
			  Height="400"
			  Width="600">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/WPFCommon;component/Theme/Theme.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<DockPanel Background="{StaticResource BackColorBrush}">
		<WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" VerticalAlignment="Bottom">
			<Button Width="75" Margin="6" IsDefault="True" Command="{Binding OkCommand}">OK</Button>
			<Button Width="75" Margin="6" IsCancel="True" Command="{Binding CancelCommand}">Cancel</Button>
		</WrapPanel>
		<Grid Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<TextBlock Grid.Row="0" Margin="0,0,0,8" Text="Select the imported Mark Collections to add to this sequence." TextWrapping="Wrap" />
			<ListBox Grid.Row="1"
					 ItemsSource="{Binding Options}"
					 SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
					 HorizontalContentAlignment="Stretch"
					 ScrollViewer.HorizontalScrollBarVisibility="Auto"
					 ScrollViewer.VerticalScrollBarVisibility="Auto">
				<ListBox.InputBindings>
					<KeyBinding Key="Space" Command="{Binding ToggleSelectedOptionCommand}" />
				</ListBox.InputBindings>
				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type viewModels:MarkCollectionImportOptionViewModel}">
						<Grid Margin="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<CheckBox Grid.Column="0"
									  Margin="0,0,8,0"
									  Focusable="False"
									  IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
								<Image Width="16"
									   Height="16"
									   Margin="6,0,0,0"
									   Source="/Resources;component/caution-icon.png"
									   ToolTip="{Binding DuplicateNameMessage}"
									   Visibility="{Binding HasDuplicateName, Converter={StaticResource BooleanToVisibilityConverter}}" />
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</DockPanel>
</catel:Window>
