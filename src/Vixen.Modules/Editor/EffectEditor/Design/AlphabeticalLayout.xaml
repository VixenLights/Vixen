<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:design="clr-namespace:VixenModules.Editor.EffectEditor.Design"
	xmlns:converters="clr-namespace:VixenModules.Editor.EffectEditor.Converters"
	xmlns:input="clr-namespace:VixenModules.Editor.EffectEditor.Input"
    xmlns:controls="clr-namespace:Common.WPFCommon.Controls;assembly=WPFCommon">

	<Style TargetType="{x:Type design:AlphabeticalLayout}">
		<Setter Property="Background" Value="{Binding Background}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type design:AlphabeticalLayout}">
					<StackPanel>
						<Border Visibility="{Binding EffectName, Converter={converters:StringNullOrEmptyToVisibilityConverter}}" BorderThickness="0.5,1,0.5,1" BorderBrush="#6000" Background="#10FFFFFF" CornerRadius="2,3,2,2" SnapsToDevicePixels="True"  >
							<Border BorderThickness=".5,1,0.5,1" BorderBrush="#20FFFFFF" CornerRadius="2,3,2,2" Margin="2">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Label Grid.Column="0" x:Name="EffectName" Content="{Binding EffectName, Mode=OneWay}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="10pt" />
									<Button Grid.Column="1" Command="input:PropertyGridCommands.SaveEffectDefault" ToolTip="Save as Default"
											Background="Transparent" BorderThickness="0" Padding="2" Margin="5,0,0,0" VerticalAlignment="Center">
										<Image Source="/Resources;component/disk.png" Width="16" Height="16" />
									</Button>
									<Button Grid.Column="2" Command="input:PropertyGridCommands.ClearEffectDefault" ToolTip="Reset to Built-in"
											Background="Transparent" BorderThickness="0" Padding="2" Margin="5,0,0,0" VerticalAlignment="Center">
										<Image Source="/Resources;component/arrow_refresh.png" Width="16" Height="16" />
									</Button>
									<TextBlock Grid.Column="3" TextAlignment="Right" Foreground="#DDD" Padding="5,5,5,5">
										<TextBlock.Background>
											<SolidColorBrush Color="Transparent" Opacity="0"></SolidColorBrush>
										</TextBlock.Background>
										<controls:NavigatableHyperLink NavigateUri="{Binding InformationLink, Mode=OneWay}" TextDecorations="None">
											<Image Source="/Resources;component/help.png" Width="16" Height="16" />
										</controls:NavigatableHyperLink>
									</TextBlock>
								</Grid>
							</Border>
						</Border>

						<ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
							<design:PropertyItemsLayout Grid.IsSharedSizeScope="True" ItemsSource="{Binding Properties}"
						                            Background="{Binding ItemsBackground}" />
						</ScrollViewer>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>